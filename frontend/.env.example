# OptiBiz Frontend Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
# Local development
VITE_API_URL=http://127.0.0.1:8000/api

# Production: set this to the public Render API URL.
# VITE_API_URL=https://optibiz-api.onrender.com/api

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Optional: Sentry Error Tracking
# VITE_SENTRY_DSN=https://...
